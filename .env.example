# Copiar como .env y ajustar según el entorno local. Nunca commitear .env
# real ni credenciales verdaderas.

# --- apps/api ---
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# DEV_AUTH_ENABLED solo tiene efecto si NODE_ENV=development; @pci/config lo
# fuerza a false en cualquier otro entorno sin importar este valor.
DEV_AUTH_ENABLED=true
DEV_SESSION_TTL_HOURS=12

# --- packages/database (compartida por apps/api) ---
# Debe coincidir con el servicio "postgres" de compose.yaml para desarrollo local.
DATABASE_URL=postgres://pci_dev:pci_dev_password@localhost:5432/pci_dev
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# --- apps/web (variables expuestas al cliente por Vite, deben empezar con VITE_) ---
VITE_API_URL=http://localhost:3000
